#!/data/data/app.clipod/files/usr/bin/sh
# Cli host launcher: manages a single Alpine Linux rootfs (proot) and enters it.
PREFIX="${PREFIX:-/data/data/app.clipod/files/usr}"
HOME="${HOME:-/data/data/app.clipod/files/home}"
ROOT="$HOME/.cli/alpine"
SHARE="$PREFIX/share/cli/alpine"
MIRROR="${CLI_ALPINE_MIRROR:-https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/aarch64}"

say() { printf '\033[1;36m[cli]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[cli]\033[0m %s\n' "$*" >&2; exit 1; }

proot_run() {
    # usage: proot_run <cmd...>   (runs inside Alpine)
    unset LD_PRELOAD   # termux-exec preload breaks proot's execve
    [ -d /sdcard ] && SD="-b /sdcard:/sdcard" || SD=""
    # hybrid mode: heavy user data lives on the SD card, system stays internal
    if [ -f "$HOME/.cli/sd-data" ]; then
        SDD=$(cat "$HOME/.cli/sd-data")
        [ -d "$SDD" ] || mkdir "$SDD" 2>/dev/null
        if [ -d "$SDD" ]; then
            for d in work cache npm apk pip; do [ -d "$SDD/$d" ] || mkdir "$SDD/$d" 2>/dev/null; done
            SD="$SD -b $SDD/work:/root/work -b $SDD/cache:/root/.cache -b $SDD/npm:/root/.npm -b $SDD/apk:/var/cache/apk -b $SDD/pip:/root/.cache/pip"
        else
            echo "[cli] warning: SD card data dir missing ($SDD) - using internal"
        fi
    fi
    mkdir -p "$ROOT/tmp" "$HOME/.cli/tmp"
    PROOT_TMP_DIR="$HOME/.cli/tmp" proot --kill-on-exit --link2symlink -0 -r "$ROOT" \
        -b /dev -b /proc -b /sys -b "$ROOT/tmp:/dev/shm" $SD -w /root \
        /usr/bin/env -i HOME=/root USER=root LOGNAME=root SHELL=/bin/bash \
        TERM="${TERM:-xterm-256color}" COLORTERM=truecolor LANG=C.UTF-8 CLI_IN_ALPINE=1 \
        PATH=/root/.local/bin:/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        "$@"
}


# ---------------------------------------------------------------- friendly UI
C0=$(printf '\033[0m'); BD=$(printf '\033[1m'); DM=$(printf '\033[2m')
CY=$(printf '\033[1;36m'); GR=$(printf '\033[1;32m'); RD=$(printf '\033[1;31m'); YL=$(printf '\033[1;33m'); MG=$(printf '\033[1;35m')
LOG="$HOME/.cli/setup.log"
TOTAL=6

banner() {
    printf '\033[2J\033[H'
    printf '%s' "$CY"
    cat <<'ART'

   ____ _     ___
  / ___| |   |_ _|
 | |   | |    | |
 | |___| |___ | |
  \____|_____|___|
ART
    printf '%s   your pocket Linux terminal%s\n\n' "$DM" "$C0"
}
step()  { printf '\n%s Step %s of %s%s  %s%s%s\n' "$MG" "$1" "$TOTAL" "$C0" "$BD" "$2" "$C0"; }
ok()    { printf '   %s✔%s %s\n' "$GR" "$C0" "$*"; }
info()  { printf '   %s•%s %s\n' "$CY" "$C0" "$*"; }
warn()  { printf '   %s!%s %s\n' "$YL" "$C0" "$*"; }
bad()   { printf '   %s✘%s %s\n' "$RD" "$C0" "$*"; }

bar() { # bar <done> <total> <label>
    d=$1; t=$2; [ "$t" -gt 0 ] 2>/dev/null || t=1; [ "$d" -gt "$t" ] && d=$t
    w=22; f=$((d*w/t)); p=$((d*100/t)); b=""; n=0
    while [ $n -lt $w ]; do if [ $n -lt $f ]; then b="$b█"; else b="$b·"; fi; n=$((n+1)); done
    printf '\r\033[K   %s%s%s %3d%%  %s' "$CY" "$b" "$C0" "$p" "$3"
}
spin() { # spin <pid> <label>
    i=0
    while kill -0 "$1" 2>/dev/null; do
        case $((i%4)) in 0) c='|';; 1) c='/';; 2) c='-';; *) c='\';; esac
        printf '\r\033[K   %s%s%s %s' "$CY" "$c" "$C0" "$2"; i=$((i+1)); sleep 0.2
    done
    printf '\r\033[K'
}
retry_or_quit() { # retry_or_quit <plain-language problem> <what to do>
    echo; bad "$1"; info "$2"; info "(Technical details: $LOG)"
    printf '\n   Press %sEnter%s to try again, or type %sq%s and Enter to stop: ' "$BD" "$C0" "$BD" "$C0"
    read a; [ "$a" = q ] && { echo; say "Stopped. Open Cli again any time to continue where you left off."; exit 1; }
    return 0
}

welcome() {
    banner
    printf '   %sWelcome!%s Cli is getting your phone ready.\n\n' "$BD" "$C0"
    echo "   It will set up, all by itself:"
    echo "     • a small, fast Linux system"
    echo "     • Claude Code, AWS CLI, kubectl, helm, git, ssh, tmux"
    echo
    printf '   %sBefore you start%s\n' "$BD" "$C0"
    echo "     • Stay on Wi-Fi (about 300 MB is downloaded)"
    echo "     • Keep this screen open - it takes 5 to 10 minutes"
    echo "     • You only do this once"
    printf '\n   Press %sEnter%s to begin... ' "$BD" "$C0"; read a
}

# ------------------------------------------------------------------- storage
probe_fs() {
    t="$1/.probe"; rm -rf "$t"
    mkdir -p "$t" && ln -s x "$t/l" && chmod 755 "$t" \
      && printf '#!/bin/sh\nexit 0\n' > "$t/x.sh" && chmod 755 "$t/x.sh" && "$t/x.sh"
    r=$?; rm -rf "$t"; return $r
}

pick_storage() {
    if [ -L "$ROOT" ] && [ ! -d "$ROOT" ]; then bad "The SD card used by Cli is not inserted."; info "Insert it and try again."; exit 1; fi
    [ -e "$ROOT" ] && { ok "Storage already chosen"; return 0; }
    CAND=$(cat "$HOME/.cli/sd-candidates" 2>/dev/null); P=$(echo "$CAND" | sed -n 1p)
    if [ -z "$P" ]; then
        ok "Using phone storage (no SD card found)"; mkdir -p "$ROOT"; return 0
    fi
    # the app-specific SD folder already exists (Android creates it); never mkdir -p above it
    D="$P/cli-alpine"; mkdir "$D" 2>/dev/null
    if [ -d "$D" ] && probe_fs "$D"; then
        rmdir "$D" 2>/dev/null; mkdir "$D"; ln -s "$D" "$ROOT"
        ok "SD card found - the whole system goes on it"; return 0
    fi
    rmdir "$D" 2>/dev/null
    mkdir -p "$ROOT"
    if mkdir "$P/cli-data" 2>/dev/null || [ -d "$P/cli-data" ]; then
        echo "$P/cli-data" > "$HOME/.cli/sd-data"
        ok "SD card found - your projects and downloads will be saved on it"
        info "Android only lets apps run programs from phone storage,"
        info "so the Linux system itself (about 1.2 GB) stays on the phone."
    else
        warn "SD card found, but Android did not allow Cli to write to it."
        info "Using phone storage. (Settings > Apps > Cli > Permissions > Files and media)"
    fi
}

# --------------------------------------------------------------------- steps
st_prepare() {
    curl -fsI --max-time 15 "$MIRROR/latest-releases.yaml" >/dev/null 2>&1 || return 1
    command -v proot >/dev/null 2>&1 || return 2
    return 0
}

st_download() {
    [ -x "$ROOT/bin/busybox" ] && return 0
    [ -d "$ROOT" ] && [ ! -L "$ROOT" ] && { chmod -R u+w "$ROOT" 2>/dev/null; rm -rf "$ROOT"; }
    mkdir -p "$ROOT" "$HOME/.cli/tmp"; TMPF="$HOME/.cli/tmp/rootfs.tar.gz"; rm -f "$TMPF"
    NAME=$(curl -fsSL --max-time 30 "$MIRROR/latest-releases.yaml" 2>>"$LOG" | grep -o 'alpine-minirootfs-[0-9.]*-aarch64\.tar\.gz' | head -1)
    [ -n "$NAME" ] || return 1
    SIZE=$(curl -fsSI --max-time 30 "$MIRROR/$NAME" 2>>"$LOG" | tr -d '\r' | awk 'tolower($1)=="content-length:"{print $2}')
    curl -fsSL "$MIRROR/$NAME" -o "$TMPF" >>"$LOG" 2>&1 &
    pid=$!
    while kill -0 $pid 2>/dev/null; do
        cur=$(stat -c %s "$TMPF" 2>/dev/null || echo 0)
        bar "$cur" "${SIZE:-4000000}" "$((cur/1024)) KB"; sleep 1
    done
    wait $pid || return 1
    bar 1 1 "done"; echo
    WANT=$(curl -fsSL --max-time 30 "$MIRROR/$NAME.sha256" 2>>"$LOG" | cut -d' ' -f1)
    [ -n "$WANT" ] && [ "$WANT" = "$(sha256sum "$TMPF" | cut -d' ' -f1)" ] || return 3
    return 0
}

st_unpack() {
    [ -x "$ROOT/bin/busybox" ] && return 0
    tar -xzf "$HOME/.cli/tmp/rootfs.tar.gz" -C "$ROOT" --no-same-owner 2>>"$LOG" &
    spin $! "Unpacking Linux..."; wait $!
    rm -f "$HOME/.cli/tmp/rootfs.tar.gz"
    [ -x "$ROOT/bin/busybox" ] && [ -L "$ROOT/usr/bin/env" ]
}

st_tools() {
    printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > "$ROOT/etc/resolv.conf"
    mkdir -p "$ROOT/opt/cli"; cp "$SHARE"/* "$ROOT/opt/cli/"
    rm -f "$ROOT/root/.cli-setup-ok"
    proot_run /bin/sh /opt/cli/setup.sh 2>>"$LOG" | while IFS= read -r l; do
        case "$l" in "@@BAR "*) set -- $l; bar "$2" "$3" "$4";; esac
    done
    echo
    [ -f "$ROOT/root/.cli-setup-ok" ]
}

st_claude() {
    [ -x "$ROOT/root/.local/bin/claude" ] && return 0
    proot_run /bin/sh /opt/cli/install-claude.sh >>"$LOG" 2>&1 &
    spin $! "Downloading Claude Code (about 200 MB)..."; wait $!
    [ -x "$ROOT/root/.local/bin/claude" ] || command -v claude >/dev/null 2>&1 || proot_run /bin/sh -c 'command -v claude' >/dev/null 2>&1
}

run_step() { # run_step <fn> <problem if it fails> <what to do>
    while :; do
        "$1"; rc=$?
        [ $rc -eq 0 ] && return 0
        retry_or_quit "$2" "$3"
    done
}

cmd_setup() {
    mkdir -p "$HOME/.cli"; : >> "$LOG"
    welcome

    banner
    step 1 "Getting ready"
    run_step st_prepare "Cli can't reach the internet." "Turn on Wi-Fi (or mobile data) and make sure it works."
    ok "Internet connection works"; ok "Tools are in place"

    step 2 "Choosing where to keep your files"
    pick_storage

    step 3 "Downloading Linux (about 4 MB)"
    run_step st_download "The download did not finish." "Check your connection, then try again."
    ok "Linux downloaded and verified"

    step 4 "Unpacking Linux"
    run_step st_unpack "Linux could not be unpacked." "Make sure the phone has about 1.5 GB of free storage."
    ok "Linux is ready"

    step 5 "Installing your tools (AWS, kubectl, git, ssh...)"
    info "This is the longest part - 3 to 8 minutes. You can leave it running."
    run_step st_tools "Some tools could not be installed." "Usually a Wi-Fi hiccup. It will continue from where it stopped."
    SK=$(cat "$ROOT/root/.cli-skipped" 2>/dev/null | tr '\n' ' ')
    ok "Tools installed"
    [ -n "$SK" ] && warn "Not available right now (can add later with apk add): $SK"

    step 6 "Installing Claude Code"
    if st_claude; then ok "Claude Code is ready"; else warn "Claude Code could not be installed now."; info "No problem - run  cli-add claude  later when you're online."; fi

    touch "$ROOT/.ready"
    CV=$(proot_run /bin/sh -lc 'claude --version 2>/dev/null | head -1' 2>/dev/null)
    printf '\n%s ✔ All done!%s Everything is installed.\n\n' "$GR" "$C0"
    printf '   %sWhat to do next%s\n' "$BD" "$C0"
    printf '     %s1.%s Type  %sclaude%s  and sign in with your account\n' "$CY" "$C0" "$BD" "$C0"
    printf '\n   %sTip:%s  cli doctor  checks that everything works.\n' "$DM" "$C0"
    printf '\n   Press %sEnter%s to open your terminal... ' "$BD" "$C0"; read a
}

cmd_enter() {
    [ -f "$ROOT/.ready" ] || die "Cli is not set up yet. Type:  cli setup"
    [ $# -eq 0 ] && set -- /bin/bash -l
    proot_run "$@"
}

cmd_doctor() {
    echo "proot:   $(command -v proot || echo MISSING)"
    echo "storage: $(readlink "$ROOT" 2>/dev/null || echo "internal ($ROOT)")  sd-data: $(cat "$HOME/.cli/sd-data" 2>/dev/null || echo none)"
    echo "rootfs:  $([ -f "$ROOT/.ready" ] && echo ready || echo not-ready)  ($(du -sh "$ROOT" 2>/dev/null | cut -f1))"
    echo "arch:    $(uname -m)   android sdk: $(getprop ro.build.version.sdk 2>/dev/null)"
    [ -f "$ROOT/.ready" ] && proot_run /bin/sh -c 'echo "alpine:  $(cat /etc/alpine-release)"; for t in claude aws kubectl helm git ssh tmux node python3 docker gh; do printf "%-8s %s\n" $t "$(command -v $t || echo MISSING)"; done'
    echo
    echo "Android 12+ tip: if sessions get killed in the background, run once over adb:"
    echo "  adb shell \"settings put global settings_enable_monitor_phantom_procs false\""
    echo "  (older: adb shell device_config put activity_manager max_phantom_processes 2147483647)"
}

cmd_reset() {
    printf 'Delete the whole Alpine environment (all files in /root!)? [y/N] '; read a
    [ "$a" = y ] || exit 0
    T=$(readlink "$ROOT" 2>/dev/null); [ -n "$T" ] && { chmod -R u+w "$T" 2>/dev/null; rm -rf "$T"; rm -f "$ROOT"; }
    chmod -R u+w "$ROOT" 2>/dev/null; rm -rf "$ROOT"; say "removed. Open a new session to set up again."
}

case "$1" in
    setup)  cmd_setup ;;
    enter)  shift; cmd_enter "$@" ;;
    run)    shift; cmd_enter "$@" ;;
    doctor) cmd_doctor ;;
    reset)  cmd_reset ;;
    host)   touch "$HOME/.cli-no-auto"; say "auto-enter disabled (rm ~/.cli-no-auto to re-enable)" ;;
    *)      printf '\n  %sCli%s commands\n\n' "$BD" "$C0"
            echo "    cli setup    install / repair everything"
            echo "    cli doctor   check that everything works"
            echo "    cli enter    open the Linux terminal"
            echo "    cli reset    erase the Linux system and start over"
            echo "    cli host     skip auto-start (advanced)"
            echo; echo "  Inside Linux:  claude   cli-add <tool>"; echo ;;
esac
