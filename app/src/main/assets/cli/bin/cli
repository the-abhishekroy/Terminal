#!/data/data/app.clipod/files/usr/bin/sh
# Cli host launcher: manages a single Alpine Linux rootfs (proot) and enters it.
PREFIX="${PREFIX:-/data/data/app.clipod/files/usr}"
HOME="${HOME:-/data/data/app.clipod/files/home}"
ROOT="$HOME/.cli/alpine"
SHARE="$PREFIX/share/cli/alpine"
MIRROR="${CLI_ALPINE_MIRROR:-https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/aarch64}"

say() { printf '\033[1;36m[cli]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[cli]\033[0m %s\n' "$*" >&2; exit 1; }

proot_run() {
    # usage: proot_run <cmd...>   (runs inside Alpine)
    unset LD_PRELOAD   # termux-exec preload breaks proot's execve
    [ -d /sdcard ] && SD="-b /sdcard:/sdcard" || SD=""
    # hybrid mode: heavy user data lives on the SD card, system stays internal
    if [ -f "$HOME/.cli/sd-data" ]; then
        SDD=$(cat "$HOME/.cli/sd-data")
        if [ -d "$SDD" ]; then
            mkdir -p "$SDD/work" "$SDD/cache" "$SDD/npm"
            mkdir -p "$SDD/apk" "$SDD/pip"
            SD="$SD -b $SDD/work:/root/work -b $SDD/cache:/root/.cache -b $SDD/npm:/root/.npm -b $SDD/apk:/var/cache/apk -b $SDD/pip:/root/.cache/pip"
        else
            echo "[cli] warning: SD card data dir missing ($SDD) - using internal"
        fi
    fi
    mkdir -p "$ROOT/tmp" "$HOME/.cli/tmp"
    PROOT_TMP_DIR="$HOME/.cli/tmp" proot --kill-on-exit --link2symlink -0 -r "$ROOT" \
        -b /dev -b /proc -b /sys -b "$ROOT/tmp:/dev/shm" $SD -w /root \
        /usr/bin/env -i HOME=/root USER=root LOGNAME=root SHELL=/bin/bash \
        TERM="${TERM:-xterm-256color}" COLORTERM=truecolor LANG=C.UTF-8 CLI_IN_ALPINE=1 \
        PATH=/root/.local/bin:/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        "$@"
}

# --- storage choice: internal or SD card -------------------------------------
probe_fs() {
    # Alpine needs symlinks, chmod and executable files on the target filesystem.
    t="$1/.probe"; rm -rf "$t"
    mkdir -p "$t" && ln -s x "$t/l" && chmod 755 "$t" \
      && printf '#!/bin/sh\nexit 0\n' > "$t/x.sh" && chmod 755 "$t/x.sh" && "$t/x.sh"
    r=$?; rm -rf "$t"; return $r
}

pick_storage() {
    mkdir -p "$HOME/.cli"
    if [ -L "$ROOT" ] && [ ! -d "$ROOT" ]; then die "SD card for Cli is not mounted ($(readlink "$ROOT")). Insert it and retry."; fi
    [ -e "$ROOT" ] && return 0
    CAND=$(cat "$HOME/.cli/sd-candidates" 2>/dev/null)
    P=$(echo "$CAND" | sed -n 1p)
    if [ -z "$P" ]; then
        say "No SD card detected: everything stays on internal storage."
        mkdir -p "$ROOT"; return 0
    fi
    D="$P/cli-alpine"; mkdir -p "$D" 2>/dev/null
    if probe_fs "$D"; then
        # adoptable / ext4 SD card: the whole Linux system can live on it
        rmdir "$D" 2>/dev/null; mkdir -p "$D"
        ln -s "$D" "$ROOT" && say "SD card detected: installing the whole system on it ($D)" && return 0
    fi
    rmdir "$D" 2>/dev/null
    # normal FAT/exFAT SD card (all Samsung phones): Android forbids running programs / symlinks there
    mkdir -p "$P/cli-data" && echo "$P/cli-data" > "$HOME/.cli/sd-data"
    say "SD card detected: $P"
    say "Android mounts it as FAT (no symlinks, no executables), so the Linux system (~1.2 GB) must sit on internal storage."
    say "Everything you create goes on the SD card: /root/work, caches (~/.cache, ~/.npm), apk/pip downloads."
    mkdir -p "$ROOT"
}

cmd_setup() {
    pick_storage
    command -v proot >/dev/null 2>&1 || {
        say "Installing proot (one-time)…"
        apt-get update -y >/dev/null 2>&1
        apt-get install -y proot >/dev/null 2>&1 || pkg install -y proot || die "could not install proot (network?)"
    }
    command -v curl >/dev/null 2>&1 && command -v tar >/dev/null 2>&1 || apt-get install -y curl tar >/dev/null 2>&1

    if [ ! -x "$ROOT/bin/busybox" ]; then
        say "Downloading Alpine Linux (≈3 MB)…"
        [ -d "$ROOT" ] && [ ! -L "$ROOT" ] && { chmod -R u+w "$ROOT" 2>/dev/null; rm -rf "$ROOT"; }
        mkdir -p "$ROOT" "$HOME/.cli/tmp"
        TMPF="$HOME/.cli/tmp/rootfs.tar.gz"
        NAME=$(curl -fsSL "$MIRROR/latest-releases.yaml" | grep -o 'alpine-minirootfs-[0-9.]*-aarch64\.tar\.gz' | head -1)
        [ -n "$NAME" ] || die "could not find Alpine rootfs at $MIRROR"
        curl -fL# "$MIRROR/$NAME" -o "$TMPF" || die "download failed"
        WANT=$(curl -fsSL "$MIRROR/$NAME.sha256" | cut -d' ' -f1)
        GOT=$(sha256sum "$TMPF" | cut -d' ' -f1)
        [ -n "$WANT" ] && [ "$WANT" = "$GOT" ] || die "checksum mismatch for $NAME"
        say "Unpacking $NAME…"
        tar -xzf "$TMPF" -C "$ROOT" --no-same-owner 2>"$HOME/.cli/tar.err"
        rm -f "$TMPF"
        [ -x "$ROOT/bin/busybox" ] && [ -L "$ROOT/usr/bin/env" ] || { cat "$HOME/.cli/tar.err" | head -5; die "rootfs extraction failed"; }
    fi

    printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > "$ROOT/etc/resolv.conf"
    mkdir -p "$ROOT/opt/cli"
    cp "$SHARE"/* "$ROOT/opt/cli/"
    say "Installing tools inside Alpine (first run takes a few minutes)…"
    proot_run /bin/sh /opt/cli/setup.sh || die "Alpine setup failed. Re-run: cli setup"
    touch "$ROOT/.ready"
    say "Done."
}

cmd_enter() {
    [ -f "$ROOT/.ready" ] || die "not set up yet: run 'cli setup'"
    [ $# -eq 0 ] && set -- /bin/bash -l
    proot_run "$@"
}

cmd_doctor() {
    echo "proot:   $(command -v proot || echo MISSING)"
    echo "storage: $(readlink "$ROOT" 2>/dev/null || echo "internal ($ROOT)")  sd-data: $(cat "$HOME/.cli/sd-data" 2>/dev/null || echo none)"
    echo "rootfs:  $([ -f "$ROOT/.ready" ] && echo ready || echo not-ready)  ($(du -sh "$ROOT" 2>/dev/null | cut -f1))"
    echo "arch:    $(uname -m)   android sdk: $(getprop ro.build.version.sdk 2>/dev/null)"
    [ -f "$ROOT/.ready" ] && proot_run /bin/sh -c 'echo "alpine:  $(cat /etc/alpine-release)"; for t in claude aws kubectl helm git ssh tmux node python3 docker gh; do printf "%-8s %s\n" $t "$(command -v $t || echo MISSING)"; done'
    echo
    echo "Android 12+ tip: if sessions get killed in the background, run once over adb:"
    echo "  adb shell \"settings put global settings_enable_monitor_phantom_procs false\""
    echo "  (older: adb shell device_config put activity_manager max_phantom_processes 2147483647)"
}

cmd_reset() {
    printf 'Delete the whole Alpine environment (all files in /root!)? [y/N] '; read a
    [ "$a" = y ] || exit 0
    T=$(readlink "$ROOT" 2>/dev/null); [ -n "$T" ] && { chmod -R u+w "$T" 2>/dev/null; rm -rf "$T"; rm -f "$ROOT"; }
    chmod -R u+w "$ROOT" 2>/dev/null; rm -rf "$ROOT"; say "removed. Open a new session to set up again."
}

case "$1" in
    setup)  cmd_setup ;;
    enter)  shift; cmd_enter "$@" ;;
    run)    shift; cmd_enter "$@" ;;
    doctor) cmd_doctor ;;
    reset)  cmd_reset ;;
    host)   touch "$HOME/.cli-no-auto"; say "auto-enter disabled (rm ~/.cli-no-auto to re-enable)" ;;
    *)      echo "usage: cli {setup|enter [cmd]|doctor|reset|host}"; exit 1 ;;
esac
