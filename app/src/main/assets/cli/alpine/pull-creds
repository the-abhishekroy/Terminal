#!/bin/bash
# Copy your AWS / kube / ssh config FROM your Mac TO this phone (explicit, asks first).
# Usage: pull-creds [host]   (default host: mac)
H="${1:-mac}"
echo "This copies from $H: ~/.aws  ~/.kube  ~/.ssh/config  (+ any PEM dir you name)."
echo "Credentials will then live on this phone (inside the app's private storage). Continue? [y/N]"
read -r a; [ "$a" = y ] || exit 0
rsync -a "$H:.aws/"  ~/.aws/  && chmod 700 ~/.aws
rsync -a "$H:.kube/" ~/.kube/
rsync -a "$H:.ssh/config" ~/.ssh/config.mac && echo "saved as ~/.ssh/config.mac (review, then merge)"
read -rp "Directory on Mac holding .pem keys (blank to skip): " P
if [ -n "$P" ]; then mkdir -p ~/.ssh/pem && rsync -a "$H:$P/" ~/.ssh/pem/ && chmod 600 ~/.ssh/pem/* ; echo "PEMs in ~/.ssh/pem (update IdentityFile paths accordingly)"; fi
echo "Check: aws sts get-caller-identity ; kubectl config get-contexts"
